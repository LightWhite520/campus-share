#!/bin/sh
# This endpoint is served by a separate LAN-bound uhttpd instance.
umask 077
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
[ "$REQUEST_METHOD" = POST ] || fail post_required
case "$CONTENT_LENGTH" in ''|*[!0-9]*) fail invalid_length;; esac
[ "$CONTENT_LENGTH" -le 2048 ] || fail request_too_large
case "$CONTENT_TYPE" in application/json*) ;; *) fail json_required;; esac
# Native browsers send Origin for POST. Reject cross-origin and absent Origin.
[ "$HTTP_ORIGIN" = "http://$HTTP_HOST" ] || fail invalid_origin
case "$HTTP_HOST" in *[!a-zA-Z0-9.:-]*|'') fail invalid_host;; esac
. /usr/share/libubox/jshn.sh
data="$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)"
json_load "$data" || fail invalid_json
json_get_var token token; json_get_var action action
json_init
json_add_string token "$token"
json_add_string action "$action"
# Ignore any client-provided source address.
json_add_string client "$REMOTE_ADDR"
json_dump | /usr/libexec/campus-share request
