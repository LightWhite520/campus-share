#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
	procd_open_instance monitor
	procd_set_param command /bin/sh -c 'while :; do /usr/libexec/campus-share tick; sleep 10; done'
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() { procd_add_reload_trigger campus_share network mwan3; }
